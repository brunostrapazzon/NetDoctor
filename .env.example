# IA opcional do NetDoctor. Sem este arquivo (ou sem provedor), o NetDoctor usa
# só as explicações offline, que já funcionam completas.
#
# Copie para `.env` na pasta onde roda o NetDoctor, ou para
# %APPDATA%\NetDoctor\.env. NUNCA commite o .env (ele está no .gitignore).
#
# O que vai para a IA: só códigos do diagnóstico, gravidade, números (sinal %,
# perda %, tempo em ms) e o tipo de conexão. Nunca nome da rede, MAC, IP ou
# nome do computador.

# groq | openai | ollama | none
NETDOCTOR_LLM_PROVIDER=none

# Modelo: confira os disponíveis no console do provedor.
# Groq: GET https://api.groq.com/openai/v1/models
NETDOCTOR_LLM_MODEL=

# Chave da API (não é necessária para Ollama local).
NETDOCTOR_LLM_API_KEY=

# Opcional: outro endereço compatível com a API da OpenAI.
# Padrões: groq=https://api.groq.com/openai/v1  openai=https://api.openai.com/v1
#          ollama=http://localhost:11434/v1
NETDOCTOR_LLM_BASE_URL=

# Opcional: tempo máximo de espera em segundos (padrão 8).
NETDOCTOR_LLM_TIMEOUT=8
